{
  "name": "challenge-composer",
  "version": "0.1.1",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "typecheck": "tsc -b --noEmit",
    "prepare": "node scripts/install-git-hooks.mjs",
    "release": "release-it --config config/.release-it.json"
  },
  "dependencies": {
    "@pkcprotocol/pkc-js": "0.0.96",
    "jsonc-parser": "3.3.1",
    "lz-string": "1.5.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@bitsocial/ai-moderation-challenge": "0.3.0",
    "@bitsocial/captcha-canvas-challenge": "0.1.5",
    "@bitsocial/evm-contract-challenge": "0.1.6",
    "@bitsocial/flags-challenge": "0.1.2",
    "@bitsocial/r9k-challenge": "0.1.1",
    "@bitsocial/voucher-challenge": "0.1.3",
    "@bitsocial/wordfilter-challenge": "0.3.0",
    "@commitlint/cli": "20.4.3",
    "@commitlint/config-conventional": "20.4.3",
    "@release-it/conventional-changelog": "10.0.5",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/ui": "4.1.12",
    "commitizen": "4.3.2",
    "cz-conventional-changelog": "3.3.0",
    "happy-dom": "20.9.0",
    "release-it": "19.2.4",
    "typescript": "6.0.3",
    "vite": "8.2.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@pkcprotocol/pkc-js": {
      "probe-image-size": "7.4.0",
      "undici@7": "7.29.1",
      "uuid@13": "13.0.1",
      "ws@8": "8.21.3"
    },
    "get-uri": {
      "basic-ftp": "6.2.3"
    },
    "protobufjs": "7.6.6",
    "release-it": {
      "undici": "6.28.1"
    }
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
